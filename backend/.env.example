PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/multimart
JWT_SECRET=change_this_to_a_long_random_string
COMMISSION_PERCENT=10

# Optional services. Leave blank and the app uses a simple fallback.
REDIS_URL=
ELASTIC_URL=
# AWS S3 (image upload). Blank = images saved in /uploads folder
AWS_REGION=
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Razorpay TEST keys. Blank = demo payment mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
